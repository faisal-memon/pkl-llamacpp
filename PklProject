amends "pkl:Project"

dependencies {
  ["docker"] {
    uri = "package://github.com/faisal-memon/pkl-docker/releases/download/v0.0.3/pkl-docker@0.0.3"
  }
}

package {
  name = "pkl-llamacpp"
  license = "MIT"
  version = read?("env:PKG_VERSION") ?? "0.1.0"
  baseUri = "package://github.com/faisal-memon/pkl-llamacpp/releases/download/v\(version)/pkl-llamacpp"
  packageZipUrl = "https://github.com/faisal-memon/pkl-llamacpp/releases/download/v\(version)/pkl-llamacpp@\(version).zip"
  sourceCode = "https://github.com/faisal-memon/pkl-llamacpp"
  sourceCodeUrlScheme = "\(sourceCode)/blob/v\(version)%{path}#L%{line}"
  exclude { "out/**"; "dist/**"; "Makefile" }
}
