/// A typed llama.cpp server rendered as Docker Compose YAML.
module pkldocker.LlamaCpp

import "@docker/src/Compose.pkl"

// ── Module configuration ─────────────────────────────────────────────────────

/// Llama.cpp configuration supplied by the consumer.
config: Config = new Config {}

// ── Configuration types ──────────────────────────────────────────────────────

/// Combined llama.cpp application and Docker settings.
class Config {
  /// Llama.cpp runtime settings.
  llamacpp: LlamaCppConfig = new LlamaCppConfig {}

  /// Docker deployment settings.
  docker: DockerConfig = new DockerConfig {}
}

/// Llama.cpp runtime settings.
class LlamaCppConfig {
  modelPath: String(!isEmpty) = "/models/model.gguf"
  gpuLayers: Int = 0
  parallelism: Int = 1
  flashAttention: Boolean = true
  cacheTypeK: String(!isEmpty) = "q4_0"
  cacheTypeV: String(!isEmpty) = "q4_0"
  jinjaEnabled: Boolean = true
  mmprojOffload: Boolean = false
  contextSize: Int = 8192
  contextShiftEnabled: Boolean = true
  batchSize: Int = 512
  ubatchSize: Int = 512
  temperature: Float = 0.7
  topP: Float = 0.95
  topK: Int = 40
  minP: Float = 0.0
  repeatPenalty: Float = 1.0
  enableThinking: Boolean = false
  reasoningEnabled: Boolean = false
  thinkBudget: Int = 0
}

/// Docker deployment settings.
class DockerConfig {
  name: String(!isEmpty) = "llamacpp"
  image: String(!isEmpty) = "ghcr.io/ggml-org/llama.cpp"
  // renovate: datasource=docker depName=ghcr.io/ggml-org/llama.cpp
  imageTag: String(!isEmpty) = "server-cuda12-b11151"
  hostPort: Int(isBetween(1, 65535)) = 8080
  containerPort: Int(isBetween(1, 65535)) = 8080
  hostModelDirectory: String(!isEmpty) = "./data/models"
  modelFile: String(!isEmpty) = "model.gguf"
  networks: Mapping<String, NetworkConfig> = new {}
  gpuCount: String? = null
  restartPolicy: String? = "unless-stopped"
  hidden imageReference = "\(image):\(imageTag)"
}

/// Consumer-facing network settings.
class NetworkConfig {
  `external`: Boolean = false
}

// ── Compose service ──────────────────────────────────────────────────────────

local modelMount = "/models"
local serviceModelPath = "\(modelMount)/\(config.docker.modelFile)"
local runtimeEnvironment = new Mapping {
  ["LLAMA_ARG_MODEL"] = serviceModelPath
  ["LLAMA_ARG_PORT"] = "\(config.docker.containerPort)"
  ["LLAMA_ARG_N_GPU_LAYERS"] = "\(config.llamacpp.gpuLayers)"
  ["LLAMA_ARG_N_PARALLEL"] = "\(config.llamacpp.parallelism)"
  ["LLAMA_ARG_FLASH_ATTN"] = if (config.llamacpp.flashAttention) "on" else "off"
  ["LLAMA_ARG_CACHE_TYPE_K"] = config.llamacpp.cacheTypeK
  ["LLAMA_ARG_CACHE_TYPE_V"] = config.llamacpp.cacheTypeV
  ["LLAMA_ARG_JINJA"] = if (config.llamacpp.jinjaEnabled) "on" else "off"
  ["LLAMA_ARG_MMPROJ_OFFLOAD"] = if (config.llamacpp.mmprojOffload) "1" else "0"
  ["LLAMA_ARG_CTX_SIZE"] = "\(config.llamacpp.contextSize)"
  ["LLAMA_ARG_NO_CONTEXT_SHIFT"] = if (config.llamacpp.contextShiftEnabled) "0" else "1"
  ["LLAMA_ARG_BATCH_SIZE"] = "\(config.llamacpp.batchSize)"
  ["LLAMA_ARG_UBATCH_SIZE"] = "\(config.llamacpp.ubatchSize)"
  ["LLAMA_ARG_TEMP"] = "\(config.llamacpp.temperature)"
  ["LLAMA_ARG_TOP_P"] = "\(config.llamacpp.topP)"
  ["LLAMA_ARG_TOP_K"] = "\(config.llamacpp.topK)"
  ["LLAMA_ARG_MIN_P"] = "\(config.llamacpp.minP)"
  ["LLAMA_ARG_REPEAT_PENALTY"] = "\(config.llamacpp.repeatPenalty)"
  ["LLAMA_ARG_CHAT_TEMPLATE_KWARGS"] = "{\"enable_thinking\":\(config.llamacpp.enableThinking)}"
  ["LLAMA_ARG_REASONING"] = if (config.llamacpp.reasoningEnabled) "on" else "off"
  ["LLAMA_ARG_THINK_BUDGET"] = "\(config.llamacpp.thinkBudget)"
}

services = new Mapping {
  [config.docker.name] = new Compose.Service {
    image = config.docker.imageReference
    restart = config.docker.restartPolicy
    ports = new Listing { new Compose.Port { published = config.docker.hostPort; target = config.docker.containerPort } }
    volumes = new Listing { new Compose.Volume { source = config.docker.hostModelDirectory; target = modelMount; `read_only` = true } }
    networks = new Listing { for (network in config.docker.networks.keys) { network } }
    environment = runtimeEnvironment
    when (config.docker.gpuCount != null) {
      deploy = new Compose.Deploy { resources = new Compose.Resources { reservations = new Compose.Reservations { devices = new Listing { new Compose.Device { driver = "nvidia"; count = config.docker.gpuCount; capabilities = new Listing { "gpu" } } } } } }
    }
  }
}

networks = new Mapping {
  for (name, network in config.docker.networks) {
    [name] = new Compose.Network { `external` = network.`external` }
  }
}

// ── YAML output ──────────────────────────────────────────────────────────────

output {
  value = new Dynamic { services = module.services; networks = module.networks }
  renderer = new YamlRenderer {}
}
