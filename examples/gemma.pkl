/// Minimal llama.cpp chat server example.
amends "@docker/src/ComposeRender.pkl"

import "@docker/src/Compose.pkl"
import "../src/LlamaCpp.pkl"

local gemma = new LlamaCpp.Server {
  name = "llamacpp-main"
  hostPort = 8002
  gpuCount = "all"
  volumeMounts = new Listing { "./data/models:/models:ro" }
  networkNames = new Listing { "ai_net"; "shared_net"; "mcp_net" }
  runtime = new LlamaCpp.Runtime {
    modelPath = "/models/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf"
    gpuLayers = 99
    flashAttention = true
    cacheTypeK = "q4_0"
    cacheTypeV = "q4_0"
    contextSize = 131072
    contextShiftEnabled = false
    batchSize = 1024
    ubatchSize = 512
    topK = 64
    enableThinking = true
    reasoningEnabled = true
    thinkBudget = 2048
  }
}

config {
  services = new Mapping {
    [gemma.name] = gemma.composeService
  }
  networks = new Mapping {
    ["ai_net"] = new Compose.Network { `external` = true }
    ["shared_net"] = new Compose.Network { `external` = true }
    ["mcp_net"] = new Compose.Network { `external` = true }
  }
}
